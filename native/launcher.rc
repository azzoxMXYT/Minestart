#include "resource.h"
#include "release-version.h"

LANGUAGE 0x09, 0x01
IDI_MINESTART ICON "native/minestart.ico"
IDR_GAME RCDATA "index.html"
1 24 "native/Minestart.manifest"

1 VERSIONINFO
 FILEVERSION RELEASE_VERSION_NUM
 PRODUCTVERSION RELEASE_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 1
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Minestart - Jeu de blocs portable"
      VALUE "FileVersion", RELEASE_VERSION_TEXT
      VALUE "OriginalFilename", "Minestart.exe"
      VALUE "ProductName", "Minestart"
      VALUE "ProductVersion", RELEASE_VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
